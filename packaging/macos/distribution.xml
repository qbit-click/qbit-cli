<?xml version="1.0" encoding="UTF-8"?>
<installer-gui-script minSpecVersion="1">
    <title>Qbit CLI</title>
    <organization>com.qbit-click</organization>
    <domains enable_localSystem="true"/>
    <options customize="never" require-scripts="false" rootVolumeOnly="true"/>
    <choices-outline>
        <line choice="default">
            <line choice="com.qbit-click.qbit-cli"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <!--
      Single, consistent identifier used everywhere: pkgbuild's
      identifier flag, this choice id, this pkg-ref id, and CI's
      pkgutil forget-package step all use exactly
      "com.qbit-click.qbit-cli", with no ".pkg" suffix variant.
      Keeping every reference identical avoids CI's uninstall step
      silently failing to find the installed package receipt.
    -->
    <choice id="com.qbit-click.qbit-cli" visible="false">
        <pkg-ref id="com.qbit-click.qbit-cli"/>
    </choice>
    <pkg-ref id="com.qbit-click.qbit-cli" version="__VERSION__" onConclusion="none">component.pkg</pkg-ref>
</installer-gui-script>
