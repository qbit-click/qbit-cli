<?xml version="1.0" encoding="UTF-8"?>
<installer-gui-script minSpecVersion="1">
    <title>Qbit CLI</title>
    <organization>com.qbit-click</organization>
    <domains enable_localSystem="true"/>
    <options customize="never" require-scripts="false" rootVolumeOnly="true"/>
    <choices-outline>
        <line choice="default">
            <line choice="com.qbit-click.qbit-cli.pkg"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.qbit-click.qbit-cli.pkg" visible="false">
        <pkg-ref id="com.qbit-click.qbit-cli.pkg"/>
    </choice>
    <pkg-ref id="com.qbit-click.qbit-cli.pkg" version="0.1.3" onConclusion="none">component.pkg</pkg-ref>
</installer-gui-script>
