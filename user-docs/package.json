{
  "name": "qbit-cli-user-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "vitepress build docs",
    "preview": "vitepress preview docs --host 127.0.0.1 --port 43174",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:unit && bun run test:integration && bun run test:e2e",
    "test:unit": "vitest run tests/unit",
    "test:integration": "bun run build && vitest run tests/integration",
    "test:e2e": "playwright test",
    "check": "bun run typecheck && bun run test:unit && bun run test:integration && bun run test:e2e"
  },
  "devDependencies": {
    "@fontsource-variable/vazirmatn": "5.3.0",
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.0",
    "typescript": "7.0.2",
    "vitepress": "1.6.4",
    "vitest": "4.1.11"
  }
}
